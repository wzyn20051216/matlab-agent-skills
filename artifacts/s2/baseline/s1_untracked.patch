index 0000000..d4ced27
--- /dev/null
+++ b/matlab/validation/phase58/p58_sanitize.py
@@ -0,0 +1,182 @@
+"""Credential scrubbing for archived client transcripts.
+
+The Phase 5.8 leak was an agent-owned command that read MATLAB's
+`sessionDetails.json`; the client transcript then contained the key inside an
+escaped JSON string, and the probe archived stdout/stderr verbatim. This module
+removes credential material before any client output is persisted.
+
+Covered shapes: plain JSON fields, escaped/nested JSON fields, `x-api-key`,
+`Authorization: Bearer|Basic`, `--api-key value|=value`, env-style assignments,
+bare UUIDs, and bare hex tokens >= 32 chars. A residual keyword/value pattern
+drops the whole line as a last resort.
+
+Redaction is deterministic: the replacement embeds the first 12 hex characters
+of the value's SHA-256 so distinct leaks remain distinguishable without
+revealing the value.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+from typing import Any, Iterable, Tuple
+
+REDACTED = "<REDACTED>"
+CREDENTIAL_KEYS = (
+    "api[-_]?key",
+    "x-api-key",
+    "authorization",
+    "proxy-authorization",
+    "access[-_]?token",
+    "refresh[-_]?token",
+    "client[-_]?secret",
+    "password",
+    "token",
+    "certificate",
+)
+_KEY_ONLY_RE = re.compile(r"(?i)^(?:" + "|".join(CREDENTIAL_KEYS) + r")$")
+_QUOTE = r'\\*"'
+_KEY = r"(?:" + "|".join(CREDENTIAL_KEYS) + r")"
+_JSON_FIELD_RE = re.compile(
+    r"(?i)(" + _QUOTE + r")(" + _KEY + r")(" + _QUOTE + r"\s*:\s*" + _QUOTE + r")"
+    r"((?:[^\"\\]|\\.)*)(" + _QUOTE + r")"
+)
+_BEARER_RE = re.compile(r"(?i)\b(bearer|basic)(\s+)([A-Za-z0-9._~+/=\-]{8,})")
+_ARGV_RE = re.compile(r"(?i)(--api[-_]?key(?:=|\s+))([^\s,;\"']+)")
+_FIELD_RE = re.compile(
+    r"(?i)(?<![A-Za-z0-9])(" + _KEY + r")(\s*[:=]\s*)(?!<REDACTED)([^\s,;\"']+)"
+)
+_UUID_RE = re.compile(
+    r"\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\b"
+)
+_HEX_RE = re.compile(r"\b[0-9a-fA-F]{32,}\b")
+_RESIDUAL_RE = re.compile(
+    r"(?i)(?<![A-Za-z0-9])(?:" + "|".join(CREDENTIAL_KEYS) + r")\b\s*[:=](?!\s*<REDACTED)"
+)
+_LINE_MARKER = "<REDACTED:credential-line>"
+
+
+def _token(value: str) -> str:
+    digest = hashlib.sha256(value.encode("utf-8", "surrogatepass")).hexdigest()[:12]
+    return f"<REDACTED:sha256-{digest}>"
+
+
+def _redact_text_line(line: str, secrets: Iterable[str]) -> Tuple[str, int]:
+    count = 0
+    text = line
+    for secret in secrets:
+        if secret and len(secret) >= 4 and secret in text:
+            text = text.replace(secret, REDACTED)
+            count += 1
+
+    def replace(match: re.Match) -> str:
+        nonlocal count
+        count += 1
+        return match.group(1) + match.group(2) + match.group(3) + _token(match.group(4)) + match.group(5)
+
+    text = _JSON_FIELD_RE.sub(replace, text)
+
+    def replace_bearer(match: re.Match) -> str:
+        nonlocal count
+        count += 1
+        return match.group(1) + match.group(2) + _token(match.group(3))
+
+    text = _BEARER_RE.sub(replace_bearer, text)
+
+    def replace_argv(match: re.Match) -> str:
+        nonlocal count
+        count += 1
+        return match.group(1) + _token(match.group(2))
+
+    text = _ARGV_RE.sub(replace_argv, text)
+
+    def replace_field(match: re.Match) -> str:
+        nonlocal count
+        count += 1
+        return match.group(1) + match.group(2) + _token(match.group(3))
+
+    text = _FIELD_RE.sub(replace_field, text)
+
+    def replace_bare(match: re.Match) -> str:
+        nonlocal count
+        count += 1
+        return _token(match.group(0))
+
+    text = _UUID_RE.sub(replace_bare, text)
+    text = _HEX_RE.sub(replace_bare, text)
+
+    if _RESIDUAL_RE.search(text):
+        return _LINE_MARKER, count + 1
+    return text, count
+
+
+def sanitize_text(text: str, secrets: Iterable[str] = ()) -> Tuple[str, int]:
+    """Return (sanitized_text, replacement_count)."""
+    if not text:
+        return text, 0
+    secrets = tuple(s for s in secrets if isinstance(s, str) and len(s) >= 4)
+    lines = text.splitlines()
+    total = 0
+    output = []
+    for line in lines:
+        clean, count = _redact_text_line(line, secrets)
+        output.append(clean)
+        total += count
+    result = "\n".join(output)
+    if text.endswith(("\n", "\r")):
+        result += "\n"
+    return result, total
+
+
+def sanitize_value(value: Any) -> Tuple[Any, int]:
+    """Recursively redact credential-named keys in a parsed JSON value."""
+    if isinstance(value, dict):
+        result = {}
+        total = 0
+        for key, item in value.items():
+            if isinstance(key, str) and _KEY_ONLY_RE.match(key):
+                result[key] = _token(item) if isinstance(item, str) and item else REDACTED
+                total += 1
+                continue
+            safe, count = sanitize_value(item)
+            result[key] = safe
+            total += count
+        return result, total
+    if isinstance(value, list):
+        items = []
+        total = 0
+        for item in value:
+            safe, count = sanitize_value(item)
+            items.append(safe)
+            total += count
+        return items, total
+    if isinstance(value, str):
+        return sanitize_text(value)
+    return value, 0
+
+
+def sanitize_jsonl(text: str, secrets: Iterable[str] = ()) -> Tuple[str, int]:
+    """Sanitize each JSONL line; unparseable lines are scrubbed as plain text."""
+    if not text:
+        return text, 0
+    secrets = tuple(secrets)
+    output = []
+    total = 0
+    for line in text.splitlines():
+        if not line.strip():
+            output.append(line)
+            continue
+        try:
+            parsed = json.loads(line)
+        except json.JSONDecodeError:
+            clean, count = sanitize_text(line, secrets)
+        else:
+            safe, count = sanitize_value(parsed)
+            clean = json.dumps(safe, ensure_ascii=False, separators=(",", ":"))
+        output.append(clean)
+        total += count
+    result = "\n".join(output)
+    if text.endswith(("\n", "\r")):
+        result += "\n"
+    return result, total
diff --git a/tests/CredentialSanitizer.Tests.ps1 b/tests/CredentialSanitizer.Tests.ps1
new file mode 100644
index 0000000..11c9ba2
--- /dev/null
+++ b/tests/CredentialSanitizer.Tests.ps1
@@ -0,0 +1,122 @@
+﻿<#
+.SYNOPSIS
+凭据脱敏的形状回归：真实泄露发生在“转义 JSON / 请求头 / argv / 裸令牌”这些形态上。
+
+.DESCRIPTION
+Phase 5.8 的泄露不是明文 JSON 字段，而是客户端事件流里被再次转义的
+`\"apiKey\": \"...\"`，以及 agent 自己的命令行（`Get-Content sessionDetails.json`）。
+旧实现只覆盖 `"apiKey": "..."` 与 `apiKey=...`，因此这里把六种形态钉成回归：
+
+1. 普通 JSON 字段；
+2. 转义 / 嵌套 JSON（一层或多层反斜杠）；
+3. `x-api-key:` 请求头；
+4. `Authorization: Bearer ...`；
+5. `--api-key <v>` / `--api-key=<v>` 命令行；
+6. 裸 UUID 或 >=32 位十六进制令牌。
+
+同时验证：已知密钥字面值替换保持有效、无敏感文本逐字节不变、二次脱敏幂等。
+#>
+
+. (Join-Path $PSScriptRoot 'helpers/Assertions.ps1')
+
+$script:RepoRoot = Split-Path -Parent $PSScriptRoot
+Import-Module (Join-Path $script:RepoRoot 'scripts/MatlabAgentSkills.Core.psm1') -Force -DisableNameChecking
+Import-Module (Join-Path $script:RepoRoot 'scripts/MatlabAgentSkills.McpStdio.psm1') -Force -DisableNameChecking
+. (Join-Path $script:RepoRoot 'scripts/Start-MatlabSharedSession.ps1')
+
+$script:FakeUuid = '11111111-2222-3333-4444-555555555555'
+$script:FakeHex = '0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'
+$script:FakeBearer = 'FAKEBEARERTOKEN0123456789'
+$script:FakeArgv = 'FAKEARGVTOKEN0123456789'
+$script:FakeHeader = 'FAKEXAPIKEY0123456789'
+$script:FakeJson = 'FAKEJSONVALUE0123456789'
+
+function Get-SanitizedText {
+    param([string]$Text)
+    return (Protect-MasText -Text $Text)
+}
+
+Describe '统一脱敏函数覆盖真实泄露形态' {
+    It '普通 JSON 字段值被替换' {
+        $safe = Get-SanitizedText ('{"apiKey":"' + $script:FakeJson + '","port":47823}')
+        $safe | Should Not Match ([regex]::Escape($script:FakeJson))
+        $safe | Should Match '\[REDACTED'
+        $safe | Should Match '47823'
+    }
+
+    It '转义 / 嵌套 JSON 字段值被替换（Phase 5.8 的泄露形状）' {
+        $escaped = '{\"type\":\"item.completed\",\"aggregated_output\":\"{\\\"apiKey\\\": \\\"' + $script:FakeJson + '\\\"}\"}'
+        $safe = Get-SanitizedText $escaped
+        $safe | Should Not Match ([regex]::Escape($script:FakeJson))
+        $safe | Should Match '\[REDACTED'
+
+        $single = '{"output":"{\"apiKey\":\"' + $script:FakeJson + '\"}"}'
+        $singleSafe = Get-SanitizedText $single
+        $singleSafe | Should Not Match ([regex]::Escape($script:FakeJson))
+    }
+
+    It 'x-api-key 请求头被替换' {
+        $safe = Get-SanitizedText ('x-api-key: ' + $script:FakeHeader)
+        $safe | Should Not Match ([regex]::Escape($script:FakeHeader))
+        $safe | Should Match '\[REDACTED'
+    }
+
+    It 'Authorization Bearer 与 Basic 被替换' {
+        $safe = Get-SanitizedText ('Authorization: Bearer ' + $script:FakeBearer + "`nAuthorization: Basic " + $script:FakeBearer)
+        $safe | Should Not Match ([regex]::Escape($script:FakeBearer))
+        $safe | Should Match '\[REDACTED'
+    }
+
+    It '--api-key 的两种命令行写法都被替换' {
+        $safe = Get-SanitizedText ('tool --api-key ' + $script:FakeArgv + ' --api-key=' + $script:FakeArgv + ' --other=ok')
+        $safe | Should Not Match ([regex]::Escape($script:FakeArgv))
+        $safe | Should Match '\[REDACTED'
+        $safe | Should Match '--other=ok'
+    }
+
+    It '裸 UUID 与长十六进制令牌被替换' {
+        $safe = Get-SanitizedText ('session=' + $script:FakeUuid + ' digest=' + $script:FakeHex)
+        $safe | Should Not Match ([regex]::Escape($script:FakeUuid))
+        $safe | Should Not Match ([regex]::Escape($script:FakeHex))
+        $safe | Should Match '\[REDACTED'
+    }
+
+    It '已知密钥字面值（含短值）仍被替换' {
+        $text = 'token value SECRET-LITERAL-123 appears here'
+        $safe = Protect-MasText -Text $text -Secrets @('SECRET-LITERAL-123')
+        $safe | Should Not Match 'SECRET-LITERAL-123'
+        $safe | Should Match '\[REDACTED'
+    }
+
+    It '无敏感内容的文本逐字节不变' {
+        $control = 'MATLAB R2026a determinant=-4.0 eigenvalue=3.414214 elapsed=1.25s'
+        $safe = Get-SanitizedText $control
+        ([string]::Equals($safe, $control, [System.StringComparison]::Ordinal)) | Should Be $true
+    }
+
+    It '二次脱敏幂等' {
+        $text = 'Authorization: Bearer ' + $script:FakeBearer + '; apiKey=' + $script:FakeJson + '; id=' + $script:FakeUuid
+        $once = Get-SanitizedText $text
+        $twice = Get-SanitizedText $once
+        ([string]::Equals($once, $twice, [System.StringComparison]::Ordinal)) | Should Be $true
+    }
+}
+
+Describe '既有入口委托到统一实现后不再漏' {
+    It 'Protect-McpSensitiveText 覆盖转义 JSON / Bearer / argv / 裸 UUID' {
+        $text = '{\"apiKey\":\"' + $script:FakeJson + '\"}; Authorization: Bearer ' + $script:FakeBearer + '; --api-key ' + $script:FakeArgv + '; ' + $script:FakeUuid
+        $safe = Protect-McpSensitiveText -Text $text
+        foreach ($secret in @($script:FakeJson, $script:FakeBearer, $script:FakeArgv, $script:FakeUuid)) {
+            $safe | Should Not Match ([regex]::Escape($secret))
+        }
+    }
+
+    It 'Protect-MasSecretText 覆盖转义 JSON / Bearer / argv / 裸 UUID' {
+        $text = '{\"apiKey\":\"' + $script:FakeJson + '\"}; Authorization: Bearer ' + $script:FakeBearer + '; --api-key=' + $script:FakeArgv + '; ' + $script:FakeUuid
+        $safe = Protect-MasSecretText -Text $text
+        foreach ($secret in @($script:FakeJson, $script:FakeBearer, $script:FakeArgv, $script:FakeUuid)) {
+            $safe | Should Not Match ([regex]::Escape($secret))
+        }
+        $safe | Should Match '\[REDACTED'
+    }
+}
diff --git a/tests/McpCredentialOutput.Tests.ps1 b/tests/McpCredentialOutput.Tests.ps1
new file mode 100644
index 0000000..9f78c95
--- /dev/null
+++ b/tests/McpCredentialOutput.Tests.ps1
@@ -0,0 +1,138 @@
+﻿<#
+.SYNOPSIS
+会话凭据输出面回归：探测对象、验收报告、阶段日志都不得出现 apiKey 或其绝对路径。
+
+.DESCRIPTION
+仅“把字符串里的值替换掉”不足以证明输出面安全。本用例直接检查三个落盘点：
+  - Get-McpSessionInfo 的序列化结果（不能再有 ApiKey 属性）；
+  - Invoke-McpStagedProbe 生成的验收报告（只允许文件名 + 指纹）；
+  - Write-StageLog 写入的阶段日志（命令文本可能带 Authorization / --api-key）。
+
+所有凭据都是合成值，测试目录在仓库 artifacts/ 下，不读取真实用户会话文件。
+#>
+
+. (Join-Path $PSScriptRoot 'helpers/Assertions.ps1')
+
+$script:RepoRoot = Split-Path -Parent $PSScriptRoot
+Import-Module (Join-Path $script:RepoRoot 'scripts/MatlabAgentSkills.Core.psm1') -Force -DisableNameChecking
+Import-Module (Join-Path $script:RepoRoot 'scripts/MatlabAgentSkills.Acceptance.psm1') -Force -DisableNameChecking
+Import-Module (Join-Path $script:RepoRoot 'scripts/MatlabAgentSkills.Execution.psm1') -Force -DisableNameChecking
+Import-Module (Join-Path $script:RepoRoot 'scripts/MatlabAgentSkills.McpProbe.psm1') -Force -DisableNameChecking
+
+$script:FakeApiKey = 'FAKE-SESSION-KEY-0123456789ABCDEF'
+$script:FakeBearer = 'FAKEBEARERTOKEN0123456789'
+$script:FakeUuid = '11111111-2222-3333-4444-555555555555'
+
+function New-CredentialSandbox {
+    $root = Join-Path $script:RepoRoot ('artifacts\tmp_credential_tests\' + [guid]::NewGuid().ToString('N'))
+    New-Item -ItemType Directory -Path $root -Force | Out-Null
+    return [pscustomobject]@{
+        Root          = $root
+        SessionFile   = (Join-Path $root 'sessionDetails.json')
+        Certificate   = (Join-Path $root 'cert.pem')
+        StageLog      = (Join-Path $root 'stages.log')
+        ReportPath    = (Join-Path $root 'mcp_probe.json')
+    }
+}
+
+function Remove-CredentialSandbox {
+    param($Sandbox)
+    if ($null -eq $Sandbox) { return }
+    $full = [IO.Path]::GetFullPath($Sandbox.Root)
+    $expectedPrefix = [IO.Path]::GetFullPath((Join-Path $script:RepoRoot 'artifacts\tmp_credential_tests')).TrimEnd([char[]]'\/') + [IO.Path]::DirectorySeparatorChar
+    if (-not $full.StartsWith($expectedPrefix)) { throw '测试目录越界，拒绝删除。' }
+    if (Test-Path -LiteralPath $full) { Remove-Item -LiteralPath $full -Recurse -Force -ErrorAction SilentlyContinue }
+}
+
+function New-FakeSessionFile {
+    param($Sandbox)
+    Set-Content -LiteralPath $Sandbox.Certificate -Value '-----BEGIN CERTIFICATE-----' -Encoding ascii
+    $session = [ordered]@{
+        port        = 1
+        certificate = $Sandbox.Certificate
+        apiKey      = $script:FakeApiKey
+        pid         = $PID
+    }
+    $session | ConvertTo-Json | Set-Content -LiteralPath $Sandbox.SessionFile -Encoding UTF8
+}
+
+Describe '会话凭据不出现在可序列化对象与报告中' {
+    It 'Get-McpSessionInfo 只暴露是否存在与长度，序列化后无 apiKey 值' {
+        $sandbox = New-CredentialSandbox
+        try {
+            New-FakeSessionFile $sandbox
+            $info = Get-McpSessionInfo -SessionFile $sandbox.SessionFile
+            ($info.PSObject.Properties.Name -contains 'ApiKey') | Should Be $false
+            $info.HasApiKey | Should Be $true
+            $info.ApiKeyLength | Should Be $script:FakeApiKey.Length
+
+            $json = $info | ConvertTo-Json -Depth 6
+            $json | Should Not Match ([regex]::Escape($script:FakeApiKey))
+            $json | Should Not Match '"ApiKey"\s*:'
+        }
+        finally { Remove-CredentialSandbox $sandbox }
+    }
+
+    It '鉴权仍可用：内部凭据读取函数能取回同一个值' {
+        $sandbox = New-CredentialSandbox
+        try {
+            New-FakeSessionFile $sandbox
+            $null = Get-McpSessionInfo -SessionFile $sandbox.SessionFile
+            $credential = Get-McpSessionCredential -SessionFile $sandbox.SessionFile
+            ([string]::Equals([string]$credential, $script:FakeApiKey, [System.StringComparison]::Ordinal)) | Should Be $true
+        }
+        finally { Remove-CredentialSandbox $sandbox }
+    }
+
+    It '验收报告只记录会话文件名与指纹，不含绝对路径或凭据' {
+        $sandbox = New-CredentialSandbox
+        try {
+            New-FakeSessionFile $sandbox
+            $report = Invoke-McpStagedProbe -SessionFile $sandbox.SessionFile -RepositoryRoot $sandbox.Root `
+                -Backend 'matlab-mcp-existing' -Scheme 'http' -EndpointPath '/mcp' `
+                -MatlabPath (Join-Path $sandbox.Root 'no-matlab.exe') `
+                -IoProbeDirectory (Join-Path $sandbox.Root 'io_probe') `
+                -TimeoutSeconds 2 -SkipStage1 -SkipCodexCli -SkipUserConfigs -SkipTlsValidation
+
+            $sessionCheck = @($report.checks | Where-Object { $_.id -eq 'mcp.session-config' })[0]
+            $sessionCheck.metrics.sessionFile | Should Be 'sessionDetails.json'
+            $sessionCheck.metrics.sessionFileSha256 | Should Match '^[0-9A-F]{64}$'
+            ($sessionCheck.metrics.Keys -contains 'sessionFile') | Should Be $true
+            @($sessionCheck.artifactPaths).Count | Should Be 0
+
+            $json = $report | ConvertTo-Json -Depth 20
+            $json | Should Not Match ([regex]::Escape($script:FakeApiKey))
+            $json | Should Not Match ([regex]::Escape($sandbox.SessionFile))
+            $json | Should Not Match '(?i)"sessionFilePath"'
+        }
+        finally { Remove-CredentialSandbox $sandbox }
+    }
+}
+
+Describe '阶段日志落盘前必须脱敏' {
+    It 'Authorization / --api-key / 裸 UUID 不会进入阶段日志' {
+        $sandbox = New-CredentialSandbox
+        try {
+            $detail = 'pwsh -Command "tool --api-key ' + $script:FakeBearer + '" ; Authorization: Bearer ' + $script:FakeBearer + ' ; id=' + $script:FakeUuid
+            Write-StageLog -Path $sandbox.StageLog -Stage 'credential-test' -Detail $detail
+
+            $text = Get-Content -Raw -LiteralPath $sandbox.StageLog
+            $text | Should Not Match ([regex]::Escape($script:FakeBearer))
+            $text | Should Not Match ([regex]::Escape($script:FakeUuid))
+            $text | Should Match 'credential-test'
+            $text | Should Match '\[REDACTED'
+        }
+        finally { Remove-CredentialSandbox $sandbox }
+    }
+
+    It '普通启动命令保持可读' {
+        $sandbox = New-CredentialSandbox
+        try {
+            Write-StageLog -Path $sandbox.StageLog -Stage 'launch' -Detail 'matlab.exe -batch disp(version)'
+            $text = Get-Content -Raw -LiteralPath $sandbox.StageLog
+            $text | Should Match 'matlab\.exe -batch disp\(version\)'
+            $text | Should Not Match '\[REDACTED'
+        }
+        finally { Remove-CredentialSandbox $sandbox }
+    }
+}
diff --git a/tests/test_p58_probe_outputs.py b/tests/test_p58_probe_outputs.py
new file mode 100644
index 0000000..9f32fd2
--- /dev/null
+++ b/tests/test_p58_probe_outputs.py
@@ -0,0 +1,179 @@
+"""Phase 5.8 客户端探针落盘脱敏的回归测试。
+
+只替换子进程边界：真实的 JSONL 解析、脱敏、证据写入和退出码判断都会执行。
+测试目录固定在仓库 artifacts/ 下，不触碰用户目录或系统临时目录。
+"""
+
+import contextlib
+import io
+import json
+import pathlib
+import shutil
+import subprocess
+import sys
+import unittest
+import uuid
+from unittest import mock
+
+REPO = pathlib.Path(__file__).resolve().parents[1]
+PHASE58 = REPO / "matlab" / "validation" / "phase58"
+if str(PHASE58) not in sys.path:
+    sys.path.insert(0, str(PHASE58))
+
+import p58_codex_isolated_discovery as discovery_probe  # noqa: E402
+import p58_codex_task_probe as task_probe  # noqa: E402
+
+FAKE_KEY = "FAKE-PROBE-KEY-0123456789ABCDEF"
+FAKE_BEARER = "FAKEPROBEBEARER0123456789"
+
+
+class ProbeOutputSanitizationTests(unittest.TestCase):
+    def setUp(self):
+        self.base = REPO / "artifacts" / "tmp_p58_probe_tests" / uuid.uuid4().hex
+        self.base.mkdir(parents=True)
+
+    def tearDown(self):
+        prefix = (REPO / "artifacts" / "tmp_p58_probe_tests").resolve()
+        target = self.base.resolve()
+        if prefix not in target.parents:
+            raise AssertionError("测试目录越界，拒绝删除")
+        shutil.rmtree(target, ignore_errors=True)
